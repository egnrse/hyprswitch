# /usr/lib/systemd/user/hyprswitch.service
[Unit]
Description=hyprswitch daemon (gui for switching between windows)
Documentation=https://github.com/egnrse/hyprswitch
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
EnvironmentFile=-/etc/default/hyprswitch
EnvironmentFile=-%h/.config/hyprswitch/args.env
Environment=SYSTEMD_SERVICE=true
ExecStart=/usr/bin/hyprswitch $HYPRSWITCH_OPTIONS init $HYPRSWITCH_ARGS
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
